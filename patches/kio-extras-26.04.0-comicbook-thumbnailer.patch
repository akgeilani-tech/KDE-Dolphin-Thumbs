+QImage ComicCreator::extractSevenZipImage(const QString &path, const QString &imagePath)
+{
+    QProcess process;
+
+    const QString p7zip = QStandardPaths::findExecutable(QStringLiteral("7z"));
+    if (p7zip.isEmpty()) {
+        return {};
+    }
+
+    process.setProgram(p7zip);
+
+    process.setArguments({
+        QStringLiteral("e"),
+        QStringLiteral("-so"),
+        QStringLiteral("-p-"),
+        path,
+        imagePath
+    });
+
+    process.setProcessChannelMode(QProcess::SeparateChannels);
+    process.start();
+
+    if (!process.waitForStarted(5000)) {
+        return {};
+    }
+
+    if (!process.waitForFinished(15000)) {
+        process.kill();
+        process.waitForFinished();
+        return {};
+    }
+
+    if (process.exitStatus() != QProcess::NormalExit || process.exitCode() != 0) {
+        return {};
+    }
+
+    const QByteArray imageData = process.readAllStandardOutput();
+
+    if (imageData.isEmpty()) {
+        return {};
+    }
+
+    QImage image;
+
+    if (!image.loadFromData(imageData)) {
+        return {};
+    }
+
+    return image;
+}
